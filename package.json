{
  "name": "anime-dashboard",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"yellow,cyan\" \"npm run api\" \"npm run web\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "api": "cd api && npm run dev",
    "api:install": "cd api && npm install",
    "install:all": "npm install && npm run api:install",
    "build:all": "npm run build && cd api && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
